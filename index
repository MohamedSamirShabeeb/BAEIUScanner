<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Course Attendance Scanner</title>
  <script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <style>
    * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { margin: 0; padding: 16px; background: #ffffff; color: #111111; display: flex; flex-direction: column; align-items: center; }
    .container { width: 100%; max-width: 440px; }
    h2 { margin: 0 0 12px 0; font-size: 1.25rem; text-align: center; }
    label { font-weight: 600; font-size: 0.9rem; display: block; margin-bottom: 6px; }
    select { width: 100%; padding: 12px; font-size: 1rem; border: 2px solid #111; border-radius: 8px; margin-bottom: 16px; background: #fff; }
    #reader { width: 100%; border: 2px solid #111; border-radius: 8px; overflow: hidden; }
    #status { margin-top: 14px; padding: 14px; border-radius: 8px; text-align: center; font-weight: 600; font-size: 1rem; background: #f3f4f6; }
    .success { background: #dcfce7 !important; color: #166534; border: 1px solid #166534; }
    .duplicate { background: #fef9c3 !important; color: #854d0e; border: 1px solid #854d0e; }
    .error { background: #fee2e2 !important; color: #991b1b; border: 1px solid #991b1b; }
    .log { margin-top: 16px; font-size: 0.85rem; color: #444; }
    .log div { padding: 6px 0; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; }
  </style>
</head>
<body>
  <div class="container">
    <h2>Course QR Check-In</h2>
    
    <label for="courseSelect">Select Active Course / Session:</label>
    <select id="courseSelect">
      <option value="Economics 101">Economics 101</option>
      <option value="Macroeconomics">Macroeconomics</option>
      <option value="Entrepreneurship">Entrepreneurship</option>
      <option value="E4C Workshop">E4C Workshop</option>
    </select>

    <div id="reader"></div>
    <div id="status">Point camera at student QR code</div>
    <div class="log" id="recentLog"></div>
  </div>

  <script>
    const WEB_APP_URL = "https://script.google.com/macros/s/AKfycbyxuOCrHwpEB-IStbvzhqPmW3MNJWy2WtnrS-HKb-PLeT8Grot3LtfPSy3eVsFZkYum/exec";
    
    let lastScannedId = "";
    let lastScanTime = 0;
    const COOLDOWN_MS = 3500; // Prevents accidental double-scans of the same student

    // Audio beep using Web Audio API (no external MP3 needed)
    function playBeep(freq = 880, duration = 0.12) {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sine";
        osc.frequency.value = freq;
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + duration);
      } catch (e) {}
    }

    function onScanSuccess(decodedText) {
      const studentId = decodedText.trim();
      const now = Date.now();
      const statusEl = document.getElementById("status");

      // Ignore identical scan within cooldown window
      if (studentId === lastScannedId && (now - lastScanTime) < COOLDOWN_MS) {
        statusEl.className = "duplicate";
        statusEl.textContent = `Already scanned: ${studentId}`;
        return;
      }

      lastScannedId = studentId;
      lastScanTime = now;
      const course = document.getElementById("courseSelect").value;

      playBeep(920, 0.12);
      statusEl.className = "success";
      statusEl.textContent = `Logging ${studentId} -> ${course}...`;

      // Add to on-screen log immediately for fast queue flow
      const logEl = document.getElementById("recentLog");
      const entry = document.createElement("div");
      const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      entry.innerHTML = `<span><strong>${studentId}</strong> (${course})</span><span>${timeStr}</span>`;
      logEl.prepend(entry);

      // Send asynchronously to Google Sheets
      fetch(WEB_APP_URL, {
        method: "POST",
        mode: "no-cors",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ course: course, studentId: studentId })
      })
      .then(() => {
        statusEl.textContent = `Checked In: ${studentId}`;
      })
      .catch(() => {
        playBeep(300, 0.25);
        statusEl.className = "error";
        statusEl.textContent = `Network error saving ${studentId}`;
      });
    }

    const html5QrcodeScanner = new Html5QrcodeScanner(
      "reader",
      { fps: 12, qrbox: { width: 240, height: 240 }, rememberLastUsedCamera: true },
      false
    );
    html5QrcodeScanner.render(onScanSuccess);
  </script>
</body>
</html>
